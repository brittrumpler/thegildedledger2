{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-gilded-ledger",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "keep_vars": true,
  "vars": {
    "SITE_URL": "https://gilded-ledger.us"
  }
}
